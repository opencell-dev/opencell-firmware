CONFIG_IDF_TARGET="esp32s3"
# RadioLib's EspHal needs 1 ms ticks for delay() resolution
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# New images must confirm themselves or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The executor task spins for the last ~1.5 ms before each slot on core 1
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Terminal role: BLE (NimBLE only) for the phone app bridge
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
# UART ISR keeps running while flash (NVS/OTA) disables the cache: at 2 Mbaud the
# 128-byte FIFO would overflow in ~0.6 ms.
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# oc_sig_term_act_prepare runs X25519 (~150 ms, PSA) in the NimBLE host task's write callback
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# BLE pairing (spec 2026-09-27-ble-pairing-design.md §2): LE Secure Connections
# only, MITM (passkey) required, bonds kept in NVS. 3 bonds x 4 CCCDs (DOWN,
# STATUS, EVENT and the GATT service's Service Changed) = 12, so a third phone's
# subscriptions fit and don't overflow the store (term_ble.c checks these).
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=12
# Pinned (already NimBLE's default): at DEBUG, NimBLE itself logs the passkey/TK.
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y
# The bs-radio's RX turnaround (RX done -> next launch, ~1 ms) runs on core 1
# and must not depend on the 16 KB instruction cache it shares with core 0
# (rx-turnaround.md §14): FreeRTOS (queues, the app lock), the SPI master's
# polling transfers and the GPIO level calls in IRAM. Our own code on that
# path is placed by main/turnaround.lf; tools/check_iram.py checks both.
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
