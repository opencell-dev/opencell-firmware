CONFIG_IDF_TARGET="esp32s3"
# RadioLib's EspHal needs 1 ms ticks for delay() resolution
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# New images must confirm themselves or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The executor task spins for the last ~1.5 ms before each slot on core 1
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Terminal role: BLE (NimBLE only) for the phone app bridge
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
# UART ISR keeps running while flash (NVS/OTA) disables the cache: at 2 Mbaud the
# 128-byte FIFO would overflow in ~0.6 ms.
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# lc_sig_term_act_prepare runs X25519 (~150 ms, PSA) in the NimBLE host task's write callback
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# BLE pairing (spec 2026-09-27-ble-pairing-design.md §2): LE Secure Connections
# only, MITM (passkey) required, bonds kept in NVS. 3 bonds x 3 notifying
# characteristics = 9 CCCDs, so a third phone's subscriptions don't evict a bond.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=9
# Pinned (already NimBLE's default): at DEBUG, NimBLE itself logs the passkey/TK.
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y
